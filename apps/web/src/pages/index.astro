---
const title = 'LifePilot - AI 生活管家';
const description = '用一句话记录今天做了什么、接下来要做什么，自动生成已办、待办、提醒和生活计划。';
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || '';
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <style>
    :root { --bg: #0b0d12; --surface: #11151d; --card: #171c26; --gold: #d4af37; --gold-soft: #b8922f; --text: #f7f2e8; --text-muted: #918a7c; --border: rgba(255,255,255,0.06); }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    .hero { text-align: center; padding: 6rem 0 4rem; }
    .hero h1 { font-size: 3rem; font-weight: 800; background: linear-gradient(135deg, var(--gold), var(--gold-soft)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 1rem; }
    .hero p { color: var(--text-muted); font-size: 1.125rem; max-width: 600px; margin: 0 auto; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; padding: 2rem 0; }
    @media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 1rem; padding: 1.5rem; }
    .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 1rem; }
    textarea, input { width: 100%; padding: 0.75rem; border-radius: 0.5rem; background: var(--surface); border: 1px solid var(--border); color: var(--text); font-size: 0.875rem; }
    textarea:focus, input:focus { outline: none; border-color: var(--gold); }
    textarea { min-height: 120px; resize: vertical; font-family: inherit; }
    .btn { padding: 0.75rem 1.5rem; border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; border: none; cursor: pointer; transition: all 0.2s; }
    .btn-primary { background: var(--gold); color: var(--bg); }
    .btn-primary:hover { background: var(--gold-soft); }
    .btn-secondary { background: var(--surface); color: var(--text-muted); border: 1px solid var(--border); }
    .actions { display: flex; gap: 0.75rem; margin-top: 1rem; }
    .badge { display: inline-flex; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; }
    .badge-gold { background: rgba(212,175,55,0.1); color: var(--gold); border: 1px solid rgba(212,175,55,0.3); }
    .hidden { display: none !important; }
    .item { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem; border-radius: 0.5rem; background: var(--surface); margin-bottom: 0.5rem; }
    .item-check { width: 1.25rem; height: 1.25rem; border-radius: 0.25rem; border: 2px solid var(--border); cursor: pointer; flex-shrink: 0; }
    .item-check.checked { background: var(--gold); border-color: var(--gold); }
    .item-title { flex: 1; font-size: 0.875rem; }
  </style>
</head>
<body>
  <div class="container">
    <section class="hero">
      <h1>LifePilot</h1>
      <p>AI 生活管家：用一句话记录今天做了什么、接下来要做什么，自动生成已办、待办、提醒和生活计划。</p>
    </section>

    <div class="grid">
      <div>
        <div class="card" style="margin-bottom: 1.5rem;">
          <h3>💡 新手引导</h3>
          <p style="color: var(--text-muted); font-size: 0.875rem;">输入一句话描述你的生活，点击生成，查看解析结果。</p>
          <button class="btn btn-secondary" id="btn-example" style="margin-top: 0.75rem;">使用示例</button>
        </div>
        <div class="card">
          <h3>✍️ 记录你的生活</h3>
          <textarea id="life-input" placeholder="输入一句话，例如：我今天写完了博客，跑了 3 公里，明天要投简历..."></textarea>
          <div class="actions">
            <button class="btn btn-primary" id="btn-generate">🚀 生成我的生活计划</button>
            <button class="btn btn-secondary" id="btn-clear">清空</button>
          </div>
        </div>
      </div>

      <div>
        <div style="margin-bottom: 1rem;">
          <span class="badge badge-gold" id="mode-badge">{apiBaseUrl ? 'API 模式' : '本地模式'}</span>
        </div>

        <div id="empty-state" class="card" style="text-align: center; padding: 3rem;">
          <div style="font-size: 3rem; margin-bottom: 1rem;">📝</div>
          <h3>开始记录</h3>
          <p style="color: var(--text-muted);">输入一句话，系统会自动解析</p>
        </div>

        <div id="done-section" class="card hidden" style="margin-bottom: 1rem;">
          <h3>✅ 已完成 <span id="done-count" class="badge badge-gold">0</span></h3>
          <div id="done-list"></div>
        </div>

        <div id="todos-section" class="card hidden" style="margin-bottom: 1rem;">
          <h3>📋 待办事项 <span id="todos-count" class="badge badge-gold">0</span></h3>
          <div id="todos-list"></div>
        </div>

        <div id="habits-section" class="card hidden" style="margin-bottom: 1rem;">
          <h3>🏃 习惯记录 <span id="habits-count" class="badge badge-gold">0</span></h3>
          <div id="habits-list"></div>
        </div>

        <div id="bills-section" class="card hidden" style="margin-bottom: 1rem;">
          <h3>💰 账单/支出 <span id="bills-count" class="badge badge-gold">0</span></h3>
          <div id="bills-list"></div>
        </div>

        <div id="suggestions-section" class="card hidden" style="margin-bottom: 1rem;">
          <h3>💡 智能建议</h3>
          <div id="suggestions-list"></div>
        </div>

        <div id="action-buttons" class="actions hidden">
          <button class="btn btn-primary" id="btn-save">💾 保存</button>
          <button class="btn btn-secondary" id="btn-export">📄 导出日报</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const apiBaseUrl = '{apiBaseUrl}';
    const input = document.getElementById('life-input');
    const example = '我今天完成了博客首页优化，跑步 3 公里，明天上午要投简历，周五前准备 AI 面试项目。';
    let currentItems = [];

    function parseLocally(text) {
      const done=[], todos=[], habits=[], bills=[], suggestions=[];
      const doneKw=['完成了','写完了','做完了','跑了','学了','看完了','交了','处理了','已经'];
      const todoKw=['要','需要','计划','准备','记得','明天','后天','周五前','下周'];
      const habitKw=['跑步','健身','阅读','学习','冥想','喝水','运动'];
      const billKw=['交了','支付','花了','买了','续费','房租','服务器','订阅'];
      
      text.split(/[,，。；;\n]+/).filter(s=>s.trim()).forEach(seg=>{
        const t=seg.trim();
        if(billKw.some(k=>t.includes(k))||/\d+\s*(元|块)/.test(t)){
          const m=t.match(/(\d+)\s*(元|块)/);
          bills.push({title:t,amount:m?parseInt(m[1]):0});
          if(doneKw.some(k=>t.includes(k))) done.push({title:t});
          return;
        }
        if(habitKw.some(k=>t.includes(k))&&doneKw.some(k=>t.includes(k))){habits.push({title:t});done.push({title:t});return;}
        if(doneKw.some(k=>t.includes(k))){done.push({title:t});return;}
        if(todoKw.some(k=>t.includes(k))){
          const due=t.includes('明天')?'明天':t.includes('周五')?'周五':t.includes('下周')?'下周':'';
          todos.push({title:t,due});
          return;
        }
        if(habitKw.some(k=>t.includes(k))){habits.push({title:t});return;}
        todos.push({title:t,due:''});
      });
      if(todos.length) suggestions.push(`建议今天先完成: ${todos[0].title}`);
      if(bills.length) suggestions.push(`今日支出 ${bills.reduce((s,b)=>s+b.amount,0)} 元`);
      return {done,todos,habits,bills,suggestions};
    }

    async function generate(){
      const text=input.value.trim();
      if(!text){alert('请输入内容');return;}
      const btn=document.getElementById('btn-generate');
      btn.disabled=true;btn.textContent='⏳ 解析中...';
      
      let result;
      try{
        if(apiBaseUrl){
          const r=await fetch(`${apiBaseUrl}/api/lifepilot/parse-entry`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text})});
          if(r.ok) result=await r.json();
        }
      }catch(e){}
      if(!result) result=parseLocally(text);
      currentItems=[...result.done,...result.todos,...result.habits,...result.bills];
      
      document.getElementById('empty-state').classList.add('hidden');
      if(result.done.length){document.getElementById('done-section').classList.remove('hidden');document.getElementById('done-count').textContent=result.done.length;document.getElementById('done-list').innerHTML=result.done.map(i=>`<div class="item"><div class="item-check" onclick="this.classList.toggle('checked')"></div><div class="item-title">${i.title}</div></div>`).join('');}
      if(result.todos.length){document.getElementById('todos-section').classList.remove('hidden');document.getElementById('todos-count').textContent=result.todos.length;document.getElementById('todos-list').innerHTML=result.todos.map(i=>`<div class="item"><div class="item-check" onclick="this.classList.toggle('checked')"></div><div class="item-title">${i.title}${i.due?' ('+i.due+')':''}</div></div>`).join('');}
      if(result.habits.length){document.getElementById('habits-section').classList.remove('hidden');document.getElementById('habits-count').textContent=result.habits.length;document.getElementById('habits-list').innerHTML=result.habits.map(i=>`<div class="item"><div class="item-title">${i.title}</div></div>`).join('');}
      if(result.bills.length){document.getElementById('bills-section').classList.remove('hidden');document.getElementById('bills-count').textContent=result.bills.length;document.getElementById('bills-list').innerHTML=result.bills.map(i=>`<div class="item"><div class="item-title">${i.title}${i.amount?' ('+i.amount+'元)':''}</div></div>`).join('');}
      if(result.suggestions.length){document.getElementById('suggestions-section').classList.remove('hidden');document.getElementById('suggestions-list').innerHTML=result.suggestions.map(s=>`<div style="padding:0.5rem;color:var(--text-muted);font-size:0.875rem;">• ${s}</div>`).join('');}
      document.getElementById('action-buttons').classList.remove('hidden');
      btn.disabled=false;btn.textContent='🚀 生成我的生活计划';
    }

    document.getElementById('btn-generate').addEventListener('click',generate);
    document.getElementById('btn-example').addEventListener('click',()=>{input.value=example;});
    document.getElementById('btn-clear').addEventListener('click',()=>{input.value='';['empty-state','done-section','todos-section','habits-section','bills-section','suggestions-section','action-buttons'].forEach(id=>{const el=document.getElementById(id);if(id==='empty-state')el.classList.remove('hidden');else el.classList.add('hidden');});});
    document.getElementById('btn-save').addEventListener('click',()=>{localStorage.setItem('mimo_lifepilot',JSON.stringify({text:input.value,items:currentItems,ts:Date.now()}));alert('已保存');});
    document.getElementById('btn-export').addEventListener('click',()=>{let md=`# 今日生活记录\n\n**日期**: ${new Date().toLocaleDateString('zh-CN')}\n\n## ✅ 已完成\n${currentItems.map(i=>`- ${i.title}`).join('\n')}\n\n---\n*由 LifePilot 生成*`;const blob=new Blob([md],{type:'text/markdown'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`life-${new Date().toISOString().split('T')[0]}.md`;a.click();});
  </script>
</body>
</html>